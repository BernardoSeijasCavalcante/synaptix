# Ignorar ambientes virtuais, node_modules e artefatos sensíveis no contexto de build do Docker
**/node_modules
**/venv
**/.venv
**/__pycache__
**/*.pyc
.git
.gitignore
frontend/dist
backend/uploads
backend/uploads/**
backend/uploads_team
backend/uploads_team/**
uploads
uploads/**
backend/synaptix.db
backend/synaptix.db*
backend/synaptix_team.db
backend/synaptix_team.db*
backend/.env
backend/.env*
backend/BOOTSTRAP_DEVICE_TOKEN.txt
synaptix.db
synaptix.db*
